{
  "name": "subjectkeybinding-sc",
  "version": "1.0.1",
  "description": "Derived subject-to-key relationship index referencing cryptographickey-sc assets",
  "main": "index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "nyc mocha --recursive",
    "start": "fabric-chaincode-node start"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "fabric-contract-api": "^2.5.4",
    "fabric-shim": "^2.5.4"
  },
  "devDependencies": {
    "chai": "^4.5.0",
    "chai-as-promised": "^7.1.2",
    "eslint": "^9.28.0",
    "mocha": "^10.8.2",
    "nyc": "^15.1.0"
  },
  "nyc": {
    "exclude": [
      "coverage/**",
      "eslint.config.js",
      "test/**"
    ],
    "reporter": [
      "text-summary",
      "html"
    ],
    "all": true,
    "check-coverage": true,
    "statements": 100,
    "branches": 100,
    "functions": 100,
    "lines": 100
  }
}
