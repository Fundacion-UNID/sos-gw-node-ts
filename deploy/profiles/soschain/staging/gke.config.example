#!/usr/bin/env bash
# Public structure-only example. Keep every real target value in the private
# per-product, per-environment deployment profile outside this repository.
export GCP_PROJECT_ID=replace-with-gcp-project-id
export GCP_REGION=replace-with-gcp-region
export GKE_CLUSTER=replace-with-staging-cluster
export GKE_LOCATION=replace-with-staging-cluster-location
export KUBE_CONTEXT=replace-with-kube-context
export K8S_NAMESPACE_GDC=replace-with-staging-namespace
export GDC_RESOURCE_NAME=replace-with-gateway-resource-name
export GDC_SECRET_NAME=replace-with-kubernetes-secret-name
export GDC_IMAGE=replace-with-region-docker.pkg.dev/replace-with-gcp-project-id/replace-with-repository/sos-gw-node-ts
export GDC_PUBLIC_URL=https://replace-with-staging-gateway-host
export GDC_STATIC_IP_NAME=replace-with-static-ip-resource-name
export GDC_GSA_EMAIL=replace-with-service-account@replace-with-gcp-project-id.iam.gserviceaccount.com
export GDC_SERVICE_TYPE=ClusterIP
export GDC_TLS_SIDECAR_ENABLED=false
export GDC_WORKLOAD_IDENTITY_ENABLED=true
export GDC_FABRIC_PEER_ALIAS_ENABLED=false
export GDC_REQUIRED_SECTORS=onehealth-research,animal-research
export ALLOWED_SECTORS=onehealth-research,animal-research
export LEDGER_MSP_ID=replace-with-staging-msp-id
export LEDGER_FABRIC_MSP_ID=replace-with-staging-msp-id
