#!/usr/bin/env bash
# Public, non-secret human staging target. Source this profile before invoking
# the shared deployer; it never supplies production custody or credentials.
export GCP_PROJECT_ID=uhc-unid
export GCP_REGION=europe-west4
export GKE_CLUSTER=fabric-uhc-unid-staging
export KUBE_CONTEXT=gke_uhc-unid_europe-west4_fabric-uhc-unid-staging
export K8S_NAMESPACE_GDC=staging-test-network-unid-v2
export GDC_RESOURCE_NAME=sos-gw-human
export GDC_SECRET_NAME=sos-gw-human-secret
export GDC_IMAGE=europe-west4-docker.pkg.dev/uhc-unid/uhc-unid/sos-gw-node-ts
export GDC_PUBLIC_URL=https://uhc-gw.unid.online
export GDC_STATIC_IP_NAME=uhc-unid-gw-staging-ip
export GDC_GSA_EMAIL=gdc-unid-node-ts-staging@uhc-unid.iam.gserviceaccount.com
export GDC_SERVICE_TYPE=LoadBalancer
export GDC_TLS_SIDECAR_ENABLED=true
export GDC_TLS_HOST=uhc-gw.unid.online
export GDC_TLS_IMAGE=caddy:2.10.2-alpine
export GDC_WORKLOAD_IDENTITY_ENABLED=true
export LEDGER_MSP_ID=UNIDSTAGINGMSP
