# Compiled TypeScript files
lib

# JavaScript Fabric chaincodes keep their authored runtime sources under lib/.
# They are not generated build output and must exist in a clean checkout.
!chaincode/subjectkeybinding-sc-javascript/lib/
!chaincode/subjectkeybinding-sc-javascript/lib/**
!chaincode/cryptographickey-sc-javascript/lib/
!chaincode/cryptographickey-sc-javascript/lib/**
!chaincode/organization-sc-javascript/lib/
!chaincode/organization-sc-javascript/lib/**
!chaincode/rolelicense-sc-javascript/lib/
!chaincode/rolelicense-sc-javascript/lib/**
!chaincode/consentaccess-sc-javascript/lib/
!chaincode/consentaccess-sc-javascript/lib/**
# Deployment overlays also keep authored validation modules under lib/. They
# are runtime inputs, not compiled output, and must survive a clean checkout.
!deploy/vetchain/animal-ica/lib/
!deploy/vetchain/animal-ica/lib/**
build

