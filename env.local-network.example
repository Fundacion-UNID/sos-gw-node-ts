# Local Docker smoke profile.
# Usage:
#   cp env.local-network.example .env.local-network
#   ./docker_build_local.sh
#   ./docker_run_local.sh
#
# Runtime values belong in the ignored `.env.local-network` file.

NODE_ENV=demo
LOCAL_SERVICE_ROLE=HOST

SECURITY_MODE=demo
NETWORK_MODE=test
FHIR_LEGACY=true
JSON_LEGACY=true
DEMO_ALLOW_INSECURE_BEARER=true
DEV_SEED=local-demo-seed

ALLOWED_SECTORS=health-research,health-care,health-index,health-tech,animal-research,animal-care,animal-index,animal-tech,onehealth-research
MAINSECTOR=health
SUBSECTORSALLOWED=research,care,index

HOST_LEGAL_NAME=example-organization
HOST_JURISDICTION=ES
HOST_COVERAGE_SCOPE=EU
HOST_ID_TYPE=TAX
HOST_ID_VALUE=000000000
HOST_ADMIN_EMAIL=user@example.invalid
HOST_ADMIN_UID=<configure-in-ignored-env>
HOST_ADMIN_ROLE="ISCO-08:1111"
HOST_TERMS_URL=https://service.example.invalid

HOST_EXTERNAL_DOMAIN=service.example.invalid
HOST_EXTERNAL_PORT=8080
ICA_EXTERNAL_DOMAIN=service.example.invalid
CA_EXTERNAL_DOMAIN=service.example.invalid
ICA_MODE=external
ICA_URL_INTERNAL=http://ica:3000
ICA_URL_EXTERNAL=http://127.0.0.1:3100
ICA_JURISDICTION=ES
ICA_DID_WEB=
ICA_TLS_CA_PEM=
HOST_INTERNAL_IP=0.0.0.0
HOST_INTERNAL_PORT=3000

PAYMENT_PROVIDER=stripe
INVOICE_PROVIDER=stripe
INVOICE_FLOW=pre
PAYMENT_ORCHESTRATION_MODE=portal-bff
PAYMENT_VERIFICATION_MODE=mock
ALLOW_NON_STRIPE_PAYMENT_CONFIRMATION=false
STRIPE_TAX_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SIGNING_SECRET=
STRIPE_SUCCESS_URL=http://localhost:8081/payment/success
STRIPE_CANCEL_URL=http://localhost:8081/payment/cancel

KEK_SECRET=
KMS_PROVIDER=memory
KMS_KEY_ID=
KMS_REGION=
KMS_RUNTIME_KEK_ID=
KMS_RUNTIME_KEK_CIPHERTEXT=
HASHICORP_TRANSIT_BASE_URL=https://service.example.invalid
HASHICORP_TRANSIT_MOUNT_PATH=transit
HASHICORP_TRANSIT_KEY_NAME=
HASHICORP_TRANSIT_TOKEN=
HASHICORP_NAMESPACE=example-environment

LEGACY_SIGN_ALG=ES384
SMART_TOKEN_LEGACY=
LEGACY_X509_DER_BASE64=
LEGACY_X509_CHAIN_BASE64=

LEDGER_PROVIDER_DEFAULT=mem
LEDGER_PROVIDER_MAP=test=mem,test-network=mem,network=mem
LEDGER_FABRIC_MSP_ID=Org1MSP
LEDGER_FABRIC_ITEM_TYPE=credential

LOCAL_CA_ARTIFACTS_DIR=
LOCAL_ICA_ARTIFACTS_DIR=

LOG_PROVIDER=console
QUEUE_PROVIDER=mem
DB_PROVIDER=mem
STORAGE_PROVIDER=mem

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=https://service.example.invalid
OLLAMA_MODEL=gemma2:latest

FIRESTORE_PROJECT_ID=example-project
GCS_BUCKET_NAME=example-bucket
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=example-project
FIREBASE_ADDITIONAL_AUTH_PROJECT_IDS=

AUTH_TOKEN_VERIFIER=demo
EIDAS_ISSUER=
EIDAS_CLIENT_ID=
EIDAS_JWKS_URI=

GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json

DEPLOY_REGION=europe-southwest1
DEPLOY_SERVICE_NAME=example-service
ARTIFACT_REGISTRY_NAME=example-service

# ------------------------------------------------------------------------------
# human profile reminder extension
# ------------------------------------------------------------------------------

TEST_ASSISTANT_NAME=Example Assistant
TEST_SUBJECT_ALIAS=Subject
TEST_CALL_LANGUAGE=es-ES
CALL_TTS_VOICE=Google.es-ES-Standard-A
TEST_CALL_TASK_DELAY=1m
TEST_CALL_USE_DAEMON=false
TEST_CALL_WAIT_SECONDS=120
TEST_TASK_TIMING_REPEAT_OFFSET=1
CALL_REMINDER_PAST_TIME_CAPTURE_ENABLED=true
CALL_CONTROLLER_EMAIL=user@example.invalid
TEST_INDIVIDUAL_CONTROLLER_EMAIL=user@example.invalid
TEST_TASK_MAX_ATTEMPTS=3
TEST_TASK_BASED_ON=MedicationStatement/tension-pill,MedicationStatement/paracetamol
TEST_TASK_BASED_ON_DISPLAYS=Pastilla de tension,Paracetamol 500mg
TEST_TASK_BASED_ON_DISPLAYS_ES=Pastilla de tension,Paracetamol 500mg
TEST_TASK_BASED_ON_DISPLAYS_EN=Blood pressure pill,Paracetamol 500mg

CALL_TELEPHONY_PROVIDER=twilio
CALL_REMINDERS_ENABLED=true
CALL_SMS_ENABLED=false
CALL_VOICE_ENABLED=true
CALL_VERIFY_ENABLED=false
CALL_REMINDER_DEBUG_API_ENABLED=true
CALL_REMINDER_CONSOLE_LOGS_ENABLED=true
CALL_REMINDER_DAEMON_ENABLED=false
CALL_REMINDER_DAEMON_POLL_SECONDS=15
CALL_GROUP_WINDOW_MINUTES=5
CALL_DEFAULT_LOCALE=es-ES
CALL_MAX_ATTEMPTS=3
CALL_RETRY_INTERVAL_MINUTES=5
CALL_ESCALATION_DELAY_MINUTES=30

TWILIO_ACCOUNT_SID=<TWILIO_ACCOUNT_SID-value>
TWILIO_AUTH_TOKEN=<TWILIO_AUTH_TOKEN-value>
TWILIO_VOICE_FROM_NUMBER=+1XXXXXXXXXX
TWILIO_API_KEY_SID=<TWILIO_API_KEY_SID-value>
TWILIO_API_KEY_SECRET=<TWILIO_API_KEY_SECRET-value>
TWILIO_MESSAGING_SERVICE_SID=<TWILIO_MESSAGING_SERVICE_SID-value>
TWILIO_VOICE_FLOW_SID=<TWILIO_VOICE_FLOW_SID-value>
TWILIO_VERIFY_SERVICE_SID=<TWILIO_VERIFY_SERVICE_SID-value>
TWILIO_WEBHOOK_SIGNATURE_VALIDATION=false
