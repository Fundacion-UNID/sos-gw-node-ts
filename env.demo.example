# Local demo profile (full runtime)
#
# Use this when:
# - you want the fastest local startup,
# - you do not want external DB/storage dependencies,
# - you are validating API behavior, docs, routing, and demo/test flows.
#
# This profile enables:
# - in-memory queue
# - in-memory DB/index storage
# - in-memory blob storage
# - demo-oriented security/network defaults
#
# This profile does NOT give you:
# - PostgreSQL persistence
# - Supabase storage
# - IPFS storage
# - the planned separate research-store rollout
#
# Usage:
#   cp env.demo.example .env.demo
#   npm run api:local-demo
#
# Reference:
#   docs-v2/22-environment-variables-reference.md

NODE_ENV=demo
LOCAL_SERVICE_ROLE=HOST

SECURITY_MODE=demo
NETWORK_MODE=test
FHIR_LEGACY=true
JSON_LEGACY=true
DEMO_ALLOW_INSECURE_BEARER=true
DEV_SEED=local-demo-seed

ALLOWED_SECTORS=health-research,health-care,health-index,health-tech,animal-research,animal-care,animal-index,animal-tech,onehealth-research
MAINSECTOR=health
SUBSECTORSALLOWED=research,care,index,tech

HOST_LEGAL_NAME=example-organization
HOST_JURISDICTION=ES
HOST_COVERAGE_SCOPE=EU
HOST_ID_TYPE=TAX
HOST_ID_VALUE=000000000
HOST_ADMIN_EMAIL=user@example.invalid
HOST_ADMIN_UID=<configure-in-ignored-env>
HOST_ADMIN_ROLE=RESPRSN
HOST_TERMS_URL=https://service.example.invalid

HOST_EXTERNAL_DOMAIN=service.example.invalid
HOST_EXTERNAL_PORT=
# Optional public authority domains for demo authority publication flows.
# They are NOT used to route host-side Organization/_transaction to ICA.
# In local, leave them empty unless you are explicitly testing external
# authority well-known/publication paths.
ICA_EXTERNAL_DOMAIN=service.example.invalid
CA_EXTERNAL_DOMAIN=service.example.invalid
# Trusted ICA for this host/deployment.
# Current model: one trusted operational ICA per GW host/deployment.
# This repo does not yet maintain a list of trusted ICAs or select them
# dynamically from trusted CA/issuer metadata.
ICA_MODE=external
ICA_URL_INTERNAL=http://ica:3000
ICA_URL_EXTERNAL=http://127.0.0.1:3100
ICA_JURISDICTION=ES
ICA_DID_WEB=
ICA_TLS_CA_PEM=
HOST_INTERNAL_IP=0.0.0.0
HOST_INTERNAL_PORT=3000

PAYMENT_PROVIDER=stripe
INVOICE_PROVIDER=stripe
INVOICE_FLOW=pre
PAYMENT_ORCHESTRATION_MODE=portal-bff
PAYMENT_VERIFICATION_MODE=mock
ALLOW_NON_STRIPE_PAYMENT_CONFIRMATION=false
STRIPE_TAX_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SIGNING_SECRET=
STRIPE_SUCCESS_URL=http://localhost:8081/payment/success
STRIPE_CANCEL_URL=http://localhost:8081/payment/cancel

# KMS root-key custody for wrapped tenant/host keys.
# Demo can still use a configured deterministic root secret.
# If you want KEK-backed local wrapping, keep KMS_PROVIDER=local.
# Switch to `memory` only when you want fully ephemeral dev/test behavior.
KEK_SECRET=
KMS_PROVIDER=memory
# Used when KMS_PROVIDER=gcp or aws.
KMS_KEY_ID=
KMS_REGION=
KMS_RUNTIME_KEK_ID=
KMS_RUNTIME_KEK_CIPHERTEXT=
# Used only when KMS_PROVIDER=hashicorp-transit.
HASHICORP_TRANSIT_BASE_URL=https://service.example.invalid
HASHICORP_TRANSIT_MOUNT_PATH=transit
HASHICORP_TRANSIT_KEY_NAME=
HASHICORP_TRANSIT_TOKEN=
HASHICORP_NAMESPACE=example-environment

LEGACY_SIGN_ALG=ES384
SMART_TOKEN_LEGACY=
LEGACY_X509_DER_BASE64=
LEGACY_X509_CHAIN_BASE64=

LEDGER_PROVIDER_DEFAULT=mem
LEDGER_PROVIDER_MAP=test=mem,test-network=mem,network=mem
LEDGER_FABRIC_MSP_ID=Org1MSP
LEDGER_FABRIC_ITEM_TYPE=credential

LOCAL_CA_ARTIFACTS_DIR=
LOCAL_ICA_ARTIFACTS_DIR=

LOG_PROVIDER=console
QUEUE_PROVIDER=mem
DB_PROVIDER=mem
STORAGE_PROVIDER=mem

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=https://service.example.invalid
OLLAMA_MODEL=gemma2:latest

FIRESTORE_PROJECT_ID=example-project
GCS_BUCKET_NAME=example-bucket
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=example-project
FIREBASE_ADDITIONAL_AUTH_PROJECT_IDS=

AUTH_TOKEN_VERIFIER=demo
EIDAS_ISSUER=
EIDAS_CLIENT_ID=
EIDAS_JWKS_URI=

GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json

DEPLOY_REGION=northamerica-northeast2
DEPLOY_SERVICE_NAME=example-service
ARTIFACT_REGISTRY_NAME=example-service
