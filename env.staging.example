# Generic staging shell profile for rollout checks.
# Real operator, tenant and infrastructure values belong only in the ignored
# `.env.staging` file or the deployment platform's secret store.
# Usage:
#   cp env.staging.example .env.staging
#   set -a && source .env.staging && set +a
#   npm run staging:env:check

NODE_ENV=staging
LOCAL_SERVICE_ROLE=HOST,ICA,CA

SECURITY_MODE=strict
NETWORK_MODE=test-network
FHIR_LEGACY=false
JSON_LEGACY=false
DIDCOMM_PLAIN=false
DEMO_ALLOW_INSECURE_BEARER=false

# Cross-portal binding is deny-by-default. Set only verified issuer did:web DIDs,
# never a GW URL, individual/card/controller DID or alsoKnownAs value. Configure
# the reciprocal receiving GW too when access must work in both directions.
# Example: did:web:portal-a.example,did:web:portal-b.example
SUBJECT_IDENTITY_BINDING_TRUSTED_ISSUERS=

ALLOWED_SECTORS=health-research,health-care,health-index,health-tech,animal-research,animal-care,animal-index,animal-tech,onehealth-research
MAINSECTOR=health
SUBSECTORSALLOWED=research,care,index

HOST_LEGAL_NAME=example-organization
HOST_JURISDICTION=ES
HOST_COVERAGE_SCOPE=EU
HOST_ID_TYPE=TAX
HOST_ID_VALUE=000000000
HOST_ADMIN_EMAIL=user@example.invalid
HOST_ADMIN_UID=<configure-in-ignored-env>
HOST_ADMIN_ROLE="ISCO-08|1111"
# Public origin exposed by Ingress or LoadBalancer. Never use a ClusterIP or the
# GKE control-plane endpoint. Check /host/ping and /api-docs on this origin.
HOST_PUBLIC_URL=https://service.example.invalid
HOST_EXTERNAL_DOMAIN=service.example.invalid
HOST_INTERNAL_IP=0.0.0.0
HOST_INTERNAL_PORT=3300
PORT=3300

DB_PROVIDER=firestore
STORAGE_PROVIDER=gcs
QUEUE_PROVIDER=mem
# Primary Firebase Admin/data project and default ID-token audience. Project ID,
# never the public GW or portal URL.
FIREBASE_PROJECT_ID=example-project
# Optional extra Firebase project IDs accepted only as signed token audiences.
# Does not select Firestore/GCS or grant actor/clinical authorization.
FIREBASE_ADDITIONAL_AUTH_PROJECT_IDS=
GCS_BUCKET_NAME=example-bucket

KMS_PROVIDER=gcp
KMS_KEY_ID=projects/replace-me/locations/europe-southwest1/keyRings/gw/cryptoKeys/staging
KMS_REGION=
KMS_RUNTIME_KEK_ID=
KMS_RUNTIME_KEK_CIPHERTEXT=
KEK_SECRET=

CALL_REMINDERS_ENABLED=true
CALL_REMINDERS_API_ENABLED=true
CALL_REMINDERS_WORKER_ENABLED=true
CALL_REMINDERS_FHIR_ENABLED=true
CALL_TELEPHONY_PROVIDER=twilio
CALL_VOICE_ENABLED=true
CALL_SMS_ENABLED=false
CALL_VERIFY_ENABLED=false
CALL_DEFAULT_LOCALE=es-ES
CALL_TTS_VOICE=alice
CALL_REMINDER_DAEMON_ENABLED=true
CALL_REMINDER_DAEMON_POLL_SECONDS=30

TWILIO_ACCOUNT_SID=replace-me
TWILIO_AUTH_TOKEN=
TWILIO_VOICE_FROM_NUMBER=replace-me
TWILIO_WEBHOOK_SIGNATURE_VALIDATION=true
